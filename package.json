{
  "name": "plush-story",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-pages.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "generate:catalog": "node scripts/generate-server-catalog.mjs",
    "generate:assets": "python3 scripts/generate-product-assets.py",
    "generate:og": "node scripts/export-og-manifest.mjs && python3 scripts/generate-product-og.py",
    "test:checkout": "node scripts/test-checkout-dry-run.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
